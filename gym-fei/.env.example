# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (painel do Supabase > Project Settings > API Keys / Data API).
#
# Sem estas variáveis o app abre em "modo demonstração" (dados só no aparelho).
# As duas são públicas por natureza: quem protege os dados é o RLS do banco.
# NUNCA coloque aqui a "secret key"/"service_role" nem a senha do banco.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
